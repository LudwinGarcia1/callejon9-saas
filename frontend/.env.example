# Copia este archivo como .env.local y ajusta los valores.
# .env.local nunca se commitea.

# Origen del backend. Lo usan next.config.ts (rewrites) y el cliente de API
# cuando corre en el servidor (Server Components, Route Handlers). Es
# server-only (sin prefijo NEXT_PUBLIC_) a proposito.
BACKEND_ORIGIN=http://localhost:8080

# NEXT_PUBLIC_API_BASE_URL ya NO se usa para peticiones desde el navegador:
# el navegador siempre llama a rutas relativas /api/v1/... que Next reenvia
# al backend (ver rewrites() en next.config.ts). Se documenta aqui solo para
# que quien busque la variable antigua entienda que fue reemplazada.

# Raíz pública del backend de Callejón 9, sin /api/v1. Debe ser https://.
EXPO_PUBLIC_API_URL=https://tu-backend.example.com

# Solo para pruebas en la red local (http://IP-de-tu-PC:8080).
# Se ignora fuera de desarrollo. Déjalo en false para la entrega.
EXPO_PUBLIC_ALLOW_INSECURE_HTTP=false

# Sentry (opcional). Sin DSN la app no envía errores. El DSN no es secreto.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
# Fracción de trazas de rendimiento (0 a 1). 0 las apaga.
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Callejón 9 SaaS — Variables de entorno para Docker Compose (CAL-11)
# Copia este archivo a .env para personalizar valores locales:
#   cp .env.example .env
#
# Son valores de DESARROLLO publicados en el repositorio. El perfil prod
# (SPRING_PROFILES_ACTIVE=prod) se niega a arrancar con ellos: en un entorno
# real define secretos propios (JWT_SECRET de 32 bytes o mas) y origenes
# https://. Ver la seccion "Perfiles" del README.

# PostgreSQL
POSTGRES_PASSWORD=postgres
DB_PORT=5432
DB_APP_PASSWORD=app_dev_pwd
DB_OWNER_PASSWORD=owner_dev_pwd

# Backend Spring Boot
# La imagen arranca en prod; Compose usa "default" salvo que lo cambies aqui.
SPRING_PROFILES_ACTIVE=default
BACKEND_PORT=8080
JWT_SECRET=dev-only-secret-change-me-min-32-bytes-long!!
AUTH_COOKIE_SECURE=false
APP_ALLOWED_ORIGINS=http://localhost:3000

# Frontend Next.js
FRONTEND_PORT=3000
# El destino del rewrite /api/v1 no se configura aqui: se fija al compilar
# la imagen del frontend (argumento BACKEND_ORIGIN en docker-compose.yml).
# Ver docs/cal-17-imagenes-produccion.md.

# Mercado Pago (Checkout Pro y Conciliacion en Vivo)
# Para pagos simulados (mock local): MERCADOPAGO_MOCK_ENABLED=true
# Para pagos reales (produccion): MERCADOPAGO_MOCK_ENABLED=false y MERCADOPAGO_SANDBOX=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MOCK_ENABLED=true
MERCADOPAGO_SANDBOX=true
APP_FRONTEND_BASE_URL=http://localhost:3000
APP_BACKEND_BASE_URL=http://localhost:8080

# Callejón 9 SaaS — Variables de entorno para Docker Compose (CAL-11)
# Copia este archivo a .env para personalizar valores locales:
#   cp .env.example .env
#
# Son valores de DESARROLLO publicados en el repositorio. El perfil prod
# (SPRING_PROFILES_ACTIVE=prod) se niega a arrancar con ellos: en un entorno
# real define secretos propios (JWT_SECRET de 32 bytes o mas) y origenes
# https://. Ver la seccion "Perfiles" del README.

# PostgreSQL
POSTGRES_PASSWORD=postgres
DB_PORT=5432
DB_APP_PASSWORD=app_dev_pwd
DB_OWNER_PASSWORD=owner_dev_pwd

# Backend Spring Boot
BACKEND_PORT=8080
JWT_SECRET=dev-only-secret-change-me-min-32-bytes-long!!
AUTH_COOKIE_SECURE=false
APP_ALLOWED_ORIGINS=http://localhost:3000

# Frontend Next.js
FRONTEND_PORT=3000
BACKEND_ORIGIN=http://backend:8080

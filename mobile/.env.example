# Raíz pública del backend de Callejón 9, sin /api/v1. Debe ser https://.
EXPO_PUBLIC_API_URL=https://tu-backend.example.com

# Solo para pruebas en la red local con Expo Go (http://IP-de-tu-PC:8080).
# Se ignora fuera de desarrollo. Déjalo en false para la entrega.
EXPO_PUBLIC_ALLOW_INSECURE_HTTP=false

# Raíz pública del backend de Callejón 9, sin /api/v1. Debe ser https://.
EXPO_PUBLIC_API_URL=https://tu-backend.example.com

# Solo para pruebas en la red local con Expo Go (http://IP-de-tu-PC:8080).
# Se ignora fuera de desarrollo. Déjalo en false para la entrega.
EXPO_PUBLIC_ALLOW_INSECURE_HTTP=false

# Notificaciones push (Expo Push Service). ID del proyecto de EAS: lo imprime
# `pnpm dlx eas-cli init` o aparece en expo.dev > proyecto > Overview. No es secreto.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Solo para builds de Android con FCM: ruta al google-services.json descargado de
# Firebase (por defecto ./google-services.json). El archivo no se versiona.
GOOGLE_SERVICES_JSON=./google-services.json

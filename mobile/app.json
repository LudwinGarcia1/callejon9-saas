{
  "expo": {
    "name": "RestoHub Meseros",
    "slug": "callejon9-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.callejon9.meseros"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.callejon9.meseros"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#2B2723",
          "defaultChannel": "solicitudes"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "37ff45b9-0a51-48db-99e4-769ab41458e3"
      }
    },
    "owner": "octavioduarte"
  }
}
